<!-- Onsay.csproj - the Windows app's build: a WPF program, with the core and its lingos from ..\onsay\core\bin beside it. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Onsay</AssemblyName>
    <RootNamespace>Onsay</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- The core, his hands on this computer, ships beside the app, and so do the lingos the app provides, like windows,
       which it puts in the core's lingos folder. Both come from the onsay project beside this one: build them first with
       ..\onsay\core\build.ps1. -->
  <ItemGroup>
    <None Include="..\onsay\core\bin\onsay-core.exe" Link="onsay-core.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\onsay\core\bin\onsay-core.exe')" />
    <None Include="..\onsay\core\bin\lingos\**\*" Link="lingos\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

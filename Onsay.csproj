<!-- Onsay.csproj - the Windows app's build: a WPF program, with Onsay's port for Node (port/) beside it. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8, the WPF that runs on Windows 7 SP1 and later, 32 and 64 bit, and comes with Windows 10 and 11. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- What a release makes is never a part of the build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish/**;Releases/**;port/node_modules/.package-lock.json</DefaultItemExcludes>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Onsay</AssemblyName>
    <RootNamespace>Onsay</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- His face, the Onsay mark, on the app, its windows and its taskbar button. -->
    <ApplicationIcon>onsay.ico</ApplicationIcon>
    <!-- The version this build goes by. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- What .NET Framework needs to build here, read JSON and seal keys: its reference assemblies, System.Text.Json and
       System.Security. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <!-- The brand's fonts, the website's own: Gabarito for headings, IBM Plex Sans and Mono, as Onsay Sans and Mono, for
       the rest. All under the SIL Open Font License, see fonts/OFL.txt. -->
  <ItemGroup>
    <Resource Include="fonts\*.ttf" />
  </ItemGroup>

  <!-- Onsay's port for Node, installed with npm install in port/, beside the app, run by Node (src/Core/Core.cs). -->
  <ItemGroup>
    <None Include="port\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

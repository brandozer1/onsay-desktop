<!-- Onsay.csproj - the Windows app's build: a WPF program, with the lingo client and its lingos from ..\lingo-client\core\bin beside it. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Onsay</AssemblyName>
    <RootNamespace>Onsay</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The version the installer and updates go by, set by release.ps1 for each release. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- Velopack installs and updates him, see src/System/Updates.cs and release.ps1. WebView2 draws his panel's pages,
       see src/Windows/PanelWindow.cs. -->
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.158" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <!-- The lingo client, his hands on this computer, ships beside the app, and so do the lingos it provides, like windows
       and agent, the AI agent, which go in its lingos folder. All come from the lingo-client project beside this one:
       build them first with ..\lingo-client\core\build.ps1. -->
  <ItemGroup>
    <None Include="..\lingo-client\core\bin\onsay-core.exe" Link="onsay-core.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\lingo-client\core\bin\onsay-core.exe')" />
    <None Include="..\lingo-client\core\bin\lingos\**\*" Link="lingos\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\lingo-client\lingo-library\agent.lingo" Link="lingos\agent.lingo" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

<!-- Onsay.csproj - the Windows app's build: a WPF program, with the lingo client and its lingos from ..\lingo-client\core\bin beside it. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Onsay</AssemblyName>
    <RootNamespace>Onsay</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- His face, the Onsay mark, on the app, its windows and its taskbar button. The installer uses it too (release.ps1). -->
    <ApplicationIcon>onsay.ico</ApplicationIcon>
    <!-- The version the installer and updates go by, set by release.ps1 for each release. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- Velopack installs and updates him, see src/System/Updates.cs and release.ps1. -->
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>

  <!-- The brand's fonts, the website's own: Gabarito for headings, IBM Plex Sans and Mono, as Onsay Sans and Mono, for
       the rest. All under the SIL Open Font License, see fonts/OFL.txt. -->
  <ItemGroup>
    <Resource Include="fonts\*.ttf" />
  </ItemGroup>

  <!-- The lingo client, his hands on this computer, ships beside the app, and so do its lingos, .lingo files like agent, the AI
       agent, which go in its lingos folder. All come from the lingo-client project beside this one:
       build them first with ..\lingo-client\core\build.ps1. -->
  <ItemGroup>
    <None Include="..\lingo-client\core\bin\onsay-core.exe" Link="onsay-core.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\lingo-client\core\bin\onsay-core.exe')" />
    <None Include="..\lingo-client\core\bin\lingos\*.lingo" Link="lingos\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The lingos only the app ships, not the lingo client: browser, LibreWolf driven over WebDriver BiDi. Each is packed
       from ..\lingo-client\lingo-library by the lingo client as the app builds. -->
  <Target Name="PackLingos" BeforeTargets="AssignTargetPaths" Condition="Exists('..\lingo-client\core\bin\onsay-core.exe')">
    <MakeDir Directories="$(IntermediateOutputPath)lingos" />
    <Exec Command="&quot;..\lingo-client\core\bin\onsay-core.exe&quot; &quot;..\lingo-client\core\obj\pack.json&quot; pack &quot;..\lingo-client\lingo-library\browser&quot; &quot;$(IntermediateOutputPath)lingos&quot;" />
    <ItemGroup>
      <Packed Include="$(IntermediateOutputPath)lingos\*.lingo" />
      <None Include="@(Packed)" Link="lingos\%(Packed.Filename)%(Packed.Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>

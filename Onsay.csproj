<!-- Onsay.csproj - the Windows app's build: a WPF program, with the floor and the lingos it offers from ..\lingo-client beside it. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8, the WPF that runs on Windows 7 SP1 and later, 32 and 64 bit, and comes with Windows 10 and 11. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- What release.ps1 makes is never a part of the build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish/**;Releases/**</DefaultItemExcludes>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Onsay</AssemblyName>
    <RootNamespace>Onsay</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- His face, the Onsay mark, on the app, its windows and its taskbar button. The installer uses it too (release.ps1). -->
    <ApplicationIcon>onsay.ico</ApplicationIcon>
    <!-- The version the installer and updates go by, set by release.ps1 for each release. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- What .NET Framework needs to build here, read JSON and seal keys: its reference assemblies, System.Text.Json and
       System.Security. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <!-- The brand's fonts, the website's own: Gabarito for headings, IBM Plex Sans and Mono, as Onsay Sans and Mono, for
       the rest. All under the SIL Open Font License, see fonts/OFL.txt. -->
  <ItemGroup>
    <Resource Include="fonts\*.ttf" />
  </ItemGroup>

  <!-- The floor, the lingo client made for Windows, with the Windows lingos and the update lingo built in, ships beside
       the app, and so do the lingos the app offers it, a .ls file each, like agent, the AI agent: from the lingo-client
       project beside this one, built first with ..\lingo-client\core\build.ps1. release.ps1 ships the 32-bit floor for
       32-bit Windows. -->
  <ItemGroup>
    <None Include="..\lingo-client\core\bin\windows\floor.exe" Link="floor.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\lingo-client\core\bin\windows\floor.exe')" />
    <None Include="..\lingo-client\lingo-library\*\*.ls" Link="lingos\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
